# Projeto Supabase deste módulo (Ecossistema Frota x Suprimentos).
# Pode ser o MESMO projeto Supabase do Hub "Gestão em Movimento" (basta
# rodar as migrations de supabase/migrations/ nele) ou um projeto dedicado
# — o app não assume nada além dessas duas variáveis + a service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada só em código server-only (nenhum ainda neste módulo, reservada para
# eventual sincronização em lote / jobs administrativos futuros).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública deste app (usada em links/redirects). Opcional em dev.
NEXT_PUBLIC_APP_URL=http://localhost:3001
